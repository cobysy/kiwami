{
  "name": "kiwami",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Kiwami (極) — another Japanese dictionary",
  "license": "MIT",
  "scripts": {
    "build:db": "bash scripts/build-db.sh",
    "verify:db": "node scripts/verify-db.mjs",
    "postinstall": "node scripts/copy-sql-wasm.mjs && node scripts/copy-kuromoji-dict.mjs",
    "setup:wasm": "node scripts/copy-sql-wasm.mjs",
    "setup:kuromoji": "node scripts/copy-kuromoji-dict.mjs",
    "setup:db": "node scripts/unzip-db.mjs",
    "dev": "vite",
    "build": "vite build",
    "build:pages": "vite build --outDir docs --base /kiwami/ && touch docs/.nojekyll",
    "test": "npm run test:node && npm run test:browser",
    "test:node": "vitest run --config vitest.node.config.js",
    "test:browser": "vitest run --config vitest.browser.config.js",
    "screenshot": "node scripts/screenshot.mjs",
    "rasterize-svg": "node scripts/rasterize-svg.mjs",
    "generate-squircle": "node scripts/generate-squircle.mjs",
    "bcp": "bash scripts/bcp.sh"
  },
  "dependencies": {
    "@capacitor-community/sqlite": "^8.1.0",
    "@capacitor/core": "^8.4.2",
    "fast-xml-parser": "^5.10.1",
    "fzstd": "^0.1.1",
    "jeep-sqlite": "^2.8.0",
    "kuromoji": "^0.1.2",
    "localforage": "^1.10.0",
    "pako": "^1.0.11",
    "vue": "^3.5.40",
    "wanakana": "^5.3.1"
  },
  "allowScripts": {
    "fsevents@2.3.3": true
  },
  "overrides": {
    "fsevents": "^2.3.3"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.8",
    "@vitest/browser": "^4.1.10",
    "@vitest/browser-playwright": "^4.1.10",
    "playwright": "^1.62.0",
    "sql.js": "1.11.0",
    "vite": "^8.1.5",
    "vitest": "^4.1.10"
  }
}
