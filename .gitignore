.claude/
node_modules/
data/raw/
data/build/
dist/

# Local code-indexing tool cache, not something this project generates —
# its own .gitignore already says its contents aren't meant to be committed.
.codegraph/

# public/dictionary.db itself is a build artifact regenerated from the
# tracked public/dictionary.db.zip (see scripts/unzip-db.mjs, wired into
# postinstall) — the raw .db is too large for a normal git push (~134MB,
# over GitHub's 100MB per-file limit). The .zip (~62MB) is what's tracked,
# so a fresh clone/install still needs no network access to resume dev; only
# `npm run build:db -- db` (full rebuild from source) needs it un-ignored.
public/dictionary.db

# public/assets/sql-wasm.wasm is a plain copy out of node_modules/sql.js,
# regenerated by `npm run setup:wasm` (also runs on `postinstall`) — no
# network access needed, unlike dictionary.db above, so there's no
# reproducibility reason to track it too.
public/assets/sql-wasm.wasm

# public/assets/kuromoji-dict/ is a plain copy out of node_modules/kuromoji,
# regenerated by `npm run setup:kuromoji` (also runs on `postinstall`) — same
# reasoning as sql-wasm.wasm above.
public/assets/kuromoji-dict/

# vitest browser mode's auto-captured failure screenshots.
.vitest-attachments/
tests/**/__screenshots__/
